{
  "manifest_version": 1,
  "campaign_id": "testnet-cxr-01",
  "title": "Testnet chest X-ray 01: TB, silicosis, pneumonia, fibrosis",
  "labels": ["tuberculosis", "silicosis", "pneumonia", "fibrosis"],
  "solution": {
    "base_class": "radiant_sdk.models.v1:ChestXRayClassifier",
    "sdk_version": "1.0.0",
