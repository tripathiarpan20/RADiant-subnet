  "data_pool": {"source": "datahive", "api_version": "v1", "countries": [], "positive_certainty": ["definite", "probable"]},
  "hardware": {"allowed_gpus": ["L40S", "T4"], "max_cpus": 8, "max_memory_mib": 32768},
