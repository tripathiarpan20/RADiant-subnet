# RADiant validator environment. Copy to .env and export before running probes:
#   set -a; source .env; set +a
# R1 extends this file with the full validator settings.

# ── DataHive ─────────────────────────────────────────────────────────────────
# Staging for development and testnet; production only at launch (see TODO.md).
DATAHIVE_API_BASE=
DATAHIVE_API_KEY=
# spec (v1 spec) or demo (the demo API's older routes)
DATAHIVE_API_MODE=spec
MAX_ROUNDS_PER_24H=3
