# RADiant validator environment. Copy to .env and export before running probes:
#   set -a; source .env; set +a
# R1 extends this file with the full validator settings.

# ── DataHive ─────────────────────────────────────────────────────────────────
# Staging for development and testnet; production only at launch (see TODO.md).
DATAHIVE_API_BASE=
DATAHIVE_API_KEY=
# spec (v1 spec) or demo (the demo API's older routes)
DATAHIVE_API_MODE=spec
MAX_ROUNDS_PER_24H=3

# ── R0 storage probe (S3-compatible, presigned PUT) ─────────────────────────
R0_HIPPIUS_S3_ENDPOINT=https://s3.hippius.com
R0_HIPPIUS_S3_REGION=decentralized
R0_HIPPIUS_S3_BUCKET=radiant-subnet
R0_HIPPIUS_S3_ACCESS_KEY=
R0_HIPPIUS_S3_SECRET_KEY=
R0_BACKBLAZE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
R0_BACKBLAZE_S3_REGION=us-west-004
R0_BACKBLAZE_S3_BUCKET=
R0_BACKBLAZE_S3_ACCESS_KEY=
R0_BACKBLAZE_S3_SECRET_KEY=

# ── DataHive demo API (R0 base-model scoring only) ───────────────────────────
DATAHIVE_DEMO_API_BASE=https://demo-radiology-api-12345.azurewebsites.net/api
DATAHIVE_DEMO_API_KEY=

# ── docker-compose stack (R1) ────────────────────────────────────────────────
# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
RADIANT_DB_READONLY_ROLE=radiant_readonly
# Adminer logins use this role; it can only SELECT.
RADIANT_DB_READONLY_PASSWORD=
MINIO_ROOT_USER=radiant
MINIO_ROOT_PASSWORD=
# Bucket credentials the app uses. Empty = MinIO's root user (local only).
# For Hippius or Backblaze set the endpoint and keys instead of using MinIO.
RADIANT_S3_ENDPOINT_URL=
RADIANT_S3_REGION=us-east-1
RADIANT_S3_BUCKET=radiant-solutions
RADIANT_S3_ACCESS_KEY=
RADIANT_S3_SECRET_KEY=
# Objects go under <prefix>/private/campaigns/...
RADIANT_S3_PREFIX=radiant
# Where miners' presigned PUTs go. Empty = RADIANT_S3_ENDPOINT_URL. For the
# local MinIO it must be the address miners reach (http://127.0.0.1:9000).
RADIANT_S3_PRESIGN_ENDPOINT_URL=
# test = testnet (RADiant is netuid 292; fees are testTAO), finney = mainnet, local = a local subtensor
RADIANT_NETWORK=test
RADIANT_NETUID=292
# Seeded by the init job on every `up` (a no-op once seeded). Empty = seed nothing.
RADIANT_SEED_MANIFEST=campaign/fixtures/testnet-cxr-01.json
# The wallet that receives submission fees: the owner coldkey's ss58 address.
# Seeded campaigns take their fee recipient from here (it is outside the
# manifest hash). RADIANT_FEE_TAO optionally overrides the manifest's amount.
RADIANT_FEE_RECIPIENT=
RADIANT_FEE_TAO=
# Caddy: ":80" serves plain HTTP locally; set to the API domain on the VPS
# and bind 0.0.0.0:80 / 0.0.0.0:443 so Caddy can get a certificate.
RADIANT_API_SITE=:80
RADIANT_HTTP_BIND=127.0.0.1:8080
RADIANT_HTTPS_BIND=127.0.0.1:8443

# ── chain intake (R3) ────────────────────────────────────────────────────────
# Watcher scan interval, upload authorization and presign lifetimes.
RADIANT_POLL_INTERVAL_S=30
RADIANT_UPLOAD_AUTH_TTL_S=300
RADIANT_PRESIGN_EXPIRES_S=600
# Presigns per registered hotkey per hour (bucket abuse guard).
RADIANT_UPLOADS_PER_HOTKEY_PER_HOUR=10
# Comma-separated hotkeys that submit without a fee (the owner's seed leader).
RADIANT_FEE_EXEMPT_HOTKEYS=
