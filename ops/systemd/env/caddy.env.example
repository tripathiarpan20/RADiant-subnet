# /etc/radiant/caddy.env (chmod 0600, owned by root:root)
# Loaded by caddy.service via /etc/systemd/system/caddy.service.d/override.conf.

# Public API domain (Caddy automatically provisions TLS via Let's Encrypt).
RADIANT_API_SITE=api.radiant.example

# Local radiant-api.service listener.
RADIANT_API_UPSTREAM=127.0.0.1:8000
