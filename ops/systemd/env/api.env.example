# /etc/radiant/api.env (chmod 0600, owned by root:root)
# Loaded only by radiant-api.service. Keep Modal, HF, DataHive, and wallet keys out of this file.

RADIANT_NETWORK=test
RADIANT_NETUID=292

# Neon Postgres URL for the least-privilege `radiant_api` role.
# Either the pooled (-pooler.) or direct host works; db/connection.py disables
# psycopg3 server-side prepared statements automatically for -pooler. URLs.
RADIANT_DATABASE_URL=postgresql://radiant_api:CHANGE_ME@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Solution-zip bucket (Hippius S3 in production).
RADIANT_S3_ENDPOINT_URL=https://s3.hippius.com
RADIANT_S3_PRESIGN_ENDPOINT_URL=https://s3.hippius.com
RADIANT_S3_REGION=decentralized
RADIANT_S3_BUCKET=radiant-subnet
RADIANT_S3_PREFIX=radiant
RADIANT_S3_ACCESS_KEY=
RADIANT_S3_SECRET_KEY=

# Local listener behind Caddy TLS termination.
RADIANT_API_HOST=127.0.0.1
RADIANT_API_PORT=8000

# Upload authorization and abuse limits.
RADIANT_UPLOAD_AUTH_TTL_S=300
RADIANT_PRESIGN_EXPIRES_S=600
RADIANT_UPLOADS_PER_HOTKEY_PER_HOUR=10
