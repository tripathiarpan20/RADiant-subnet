# /etc/radiant/watcher.env (chmod 0600, owned by root:root)
# Loaded only by radiant-watcher.service.

RADIANT_NETWORK=test
RADIANT_NETUID=292

# Neon Postgres URL for the least-privilege `radiant_watcher` role (pooled or direct).
RADIANT_DATABASE_URL=postgresql://radiant_watcher:CHANGE_ME@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Solution-zip bucket (Hippius S3 in production; watcher verifies uploads and deletes refused zips).
RADIANT_S3_ENDPOINT_URL=https://s3.hippius.com
RADIANT_S3_REGION=decentralized
RADIANT_S3_BUCKET=radiant-subnet
RADIANT_S3_PREFIX=radiant
RADIANT_S3_ACCESS_KEY=
RADIANT_S3_SECRET_KEY=

# Chain scan settings.
RADIANT_POLL_INTERVAL_S=30
RADIANT_FEE_EXEMPT_HOTKEYS=
RADIANT_MAX_PAYMENT_AGE_BLOCKS=7200
