# /etc/radiant/worker.env (chmod 0600, owned by root:root)
# Loaded only by radiant-worker.service. Only this service sees Modal and HF write tokens.

RADIANT_NETWORK=test
RADIANT_NETUID=292

# Neon Postgres URL for the least-privilege `radiant_worker` role (pooled or direct).
RADIANT_DATABASE_URL=postgresql://radiant_worker:CHANGE_ME@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Solution-zip bucket (Hippius S3 in production).
RADIANT_S3_ENDPOINT_URL=https://s3.hippius.com
RADIANT_S3_REGION=decentralized
RADIANT_S3_BUCKET=radiant-subnet
RADIANT_S3_PREFIX=radiant
RADIANT_S3_ACCESS_KEY=
RADIANT_S3_SECRET_KEY=

# Gate worker & scratch path (mount tmpfs here on Confidential VMs to keep scratch in encrypted RAM).
RADIANT_POLL_INTERVAL_S=30
RADIANT_WORKER_SCRATCH=/var/lib/radiant/scratch
SANDBOX_GPU_WAIT_S=900
RADIANT_INFRA_RETRY_AFTER_S=900

# Validator's Modal account for g7 image builds and g8 qualification sandboxes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
RADIANT_MODAL_ENVIRONMENT=

# Validator's private Hugging Face pin org (gate g9).
HF_PIN_ORG=
HF_PIN_TOKEN=
