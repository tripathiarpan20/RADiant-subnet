# /etc/radiant/admin.env (chmod 0600, owned by root:root)
# Manual operator CLI tasks ONLY (db.migrate --grants-only, campaign.seed,
# campaign.set_status, campaign.set_fee, worker.admin). Never loaded by any daemon.

RADIANT_NETWORK=test
RADIANT_NETUID=292

# IMPORTANT: Use Neon's DIRECT (unpooled) host here — NO "-pooler." in the hostname!
# db.migrate uses a session-level pg_advisory_lock and refuses pooled URLs.
RADIANT_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Role names created in the Neon console/API; `db.migrate --grants-only` grants
# least-privilege table/sequence permissions to these roles without needing their passwords.
RADIANT_DB_READONLY_ROLE=radiant_readonly
RADIANT_DB_API_ROLE=radiant_api
RADIANT_DB_WATCHER_ROLE=radiant_watcher
RADIANT_DB_WORKER_ROLE=radiant_worker

# Owner coldkey ss58 address receiving submission fees (required by campaign.seed).
RADIANT_FEE_RECIPIENT=
RADIANT_FEE_TAO=

# Bucket credentials (optional; used if running `python -m storage.bucket` checks).
RADIANT_S3_ENDPOINT_URL=https://s3.hippius.com
RADIANT_S3_REGION=decentralized
RADIANT_S3_BUCKET=radiant-subnet
RADIANT_S3_PREFIX=radiant
RADIANT_S3_ACCESS_KEY=
RADIANT_S3_SECRET_KEY=
