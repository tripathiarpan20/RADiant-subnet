# Copy to miner.env (never into the solution). radiant-sdk reads it.
# A dev validator during development; the production API domain at launch.
RADIANT_API_URL=http://localhost:8080
# test = testnet: the campaign fee is paid in testTAO (btcli --network test). RADiant testnet is netuid 292.
RADIANT_NETWORK=test
RADIANT_NETUID=292
WALLET_NAME=default
WALLET_HOTKEY=default
# Fee recipients you trust beyond the owner addresses pinned in the SDK
# (comma-separated). submit refuses to pay any other address a campaign names.
RADIANT_TRUSTED_FEE_RECIPIENTS=
